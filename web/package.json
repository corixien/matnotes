{
  "name": "matnotes-web",
  "version": "0.1.0",
  "private": true,
  "description": "MatNotes in the browser: LibreOffice (WebAssembly, zetajs) + end-to-end encrypted sync.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "i18n": "node scripts/gen-i18n.mjs",
    "postinstall": "node scripts/copy-zeta.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hunspell-asm": "^4.0.2",
    "zetajs": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
